{
  "name": "FASM2 Studio Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#0d0e16",
    "editor.foreground": "#c8ccdc",
    "editorLineNumber.foreground": "#454a5e",
    "editorLineNumber.activeForeground": "#c8ccdc",
    "editor.selectionBackground": "#2c3454",
    "editor.inactiveSelectionBackground": "#1b2035",
    "editor.lineHighlightBackground": "#161926",
    "editor.wordHighlightBackground": "#2c345440",
    "editor.wordHighlightStrongBackground": "#3b426150",
    "editor.findMatchBackground": "#3d5a8050",
    "editor.findMatchHighlightBackground": "#2c345450",
    "editorCursor.foreground": "#7aa2f7",
    "editorIndentGuide.background1": "#1e2233",
    "editorIndentGuide.activeBackground1": "#3b4261",
    "editorWhitespace.foreground": "#2a2e3f",
    "editorBracketMatch.background": "#2c345450",
    "editorBracketMatch.border": "#7aa2f7",
    "editorBracketHighlight.foreground1": "#7aa2f7",
    "editorBracketHighlight.foreground2": "#bb9af7",
    "editorBracketHighlight.foreground3": "#2ac3de",
    "editorGutter.modifiedBackground": "#7aa2f7",
    "editorGutter.addedBackground": "#9ece6a",
    "editorGutter.deletedBackground": "#f7768e"
  },
  "tokenColors": [
    {
      "scope": ["comment", "comment.line.semicolon.fasm"],
      "settings": { "foreground": "#5f6785", "fontStyle": "italic" }
    },
    {
      "scope": ["string.quoted.single.fasm", "string.quoted.double.fasm"],
      "settings": { "foreground": "#9ece6a" }
    },
    {
      "scope": "constant.character.escape.fasm",
      "settings": { "foreground": "#c3e88d", "fontStyle": "bold" }
    },
    {
      "scope": [
        "constant.numeric.float.fasm",
        "constant.numeric.hex.fasm",
        "constant.numeric.binary.fasm",
        "constant.numeric.octal.fasm",
        "constant.numeric.decimal.fasm"
      ],
      "settings": { "foreground": "#ff9e64" }
    },
    {
      "scope": "keyword.control.import.fasm",
      "settings": { "foreground": "#bb9af7" }
    },
    {
      "scope": "entity.name.label.fasm",
      "settings": { "foreground": "#ffcb6b", "fontStyle": "bold" }
    },
    {
      "scope": "entity.name.label.local.fasm",
      "settings": { "foreground": "#f2cc8f" }
    },
    {
      "scope": "punctuation.separator.label.fasm",
      "settings": { "foreground": "#6b7089" }
    },
    {
      "scope": "keyword.control.directive.fasm",
      "settings": { "foreground": "#bb9af7" }
    },
    {
      "scope": "entity.name.function.fasm",
      "settings": { "foreground": "#82e0aa", "fontStyle": "bold" }
    },
    {
      "scope": "variable.other.member.fasm",
      "settings": { "foreground": "#b4bee0" }
    },
    {
      "scope": "punctuation.accessor.fasm",
      "settings": { "foreground": "#6b7089" }
    },
    {
      "scope": "variable.other.constant.fasm",
      "settings": { "foreground": "#7dcfff" }
    },
    {
      "scope": "keyword.operator.assignment.fasm",
      "settings": { "foreground": "#82aaff" }
    },
    {
      "scope": "keyword.other.calm.fasm",
      "settings": { "foreground": "#c678dd" }
    },
    {
      "scope": "support.function.fasm",
      "settings": { "foreground": "#4fd6be" }
    },
    {
      "scope": ["storage.type.data.fasm", "storage.type.fasm"],
      "settings": { "foreground": "#e0af68" }
    },
    {
      "scope": "support.constant.format.fasm",
      "settings": { "foreground": "#ecc48d" }
    },
    {
      "scope": "variable.language.register.fasm",
      "settings": { "foreground": "#2ac3de" }
    },
    {
      "scope": "keyword.other.mnemonic.fasm",
      "settings": { "foreground": "#7aa2f7" }
    },
    {
      "scope": "variable.language.special.fasm",
      "settings": { "foreground": "#89ddff", "fontStyle": "italic" }
    },
    {
      "scope": "keyword.operator.fasm",
      "settings": { "foreground": "#7f89b3" }
    }
  ]
}
